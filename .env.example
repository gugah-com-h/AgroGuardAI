# Copie para `.env` e preencha. O `.env` está no .gitignore — não versione.
#
# ATENÇÃO: toda variável com prefixo VITE_ é embutida no JavaScript enviado ao
# navegador. Qualquer visitante do site consegue lê-la. Portanto:
#   1. Gere a chave em https://aistudio.google.com/apikey
#   2. Restrinja a chave por referenciador HTTP no Google Cloud Console
#      (APIs e Serviços > Credenciais > a chave > Restrições de aplicativo)
#   3. Nunca reutilize uma chave que já tenha sido exposta
#
# A alternativa definitiva é mover a chamada ao Gemini para o backend.
# Veja a seção "Segurança da chave" no README.
VITE_GEMINI_KEY=

# Opcional — cascata de modelos, em ordem de preferência (separados por vírgula).
# O primeiro que responder é usado. Padrão: gemini-2.5-flash,gemini-2.0-flash
VITE_GEMINI_MODELS=

# Opcional — URL base da API do AgroGuard. Padrão: /api (proxy do Vite em dev).
VITE_API_BASE=
